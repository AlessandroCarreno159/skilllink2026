@* Layout principal: navbar, campana, Panel, footer y alertas *@
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] | SkillLink — Conectando talento técnico</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/skilllink.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <nav class="navbar navbar-expand-xl navbar-light shadow-sm navbar-skilllink">
        <div class="container-fluid px-lg-4">
            <a class="navbar-brand fw-bold flex-shrink-0" asp-controller="Home" asp-action="Index">
                <i class="bi bi-link-45deg"></i> SkillLink
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMain">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse navbar-skilllink-collapse" id="navMain">
                <div class="navbar-skilllink-row">
                    <div class="sk-navpill">
                    <ul class="navbar-nav navbar-skilllink-left align-items-xl-center">
                        <li class="nav-item"><a class="nav-link" asp-controller="Feed" asp-action="Index">Feed laboral</a></li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @if (User.IsInRole("trabajador"))
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="Solicitudes" asp-action="MisPostulaciones">Postulaciones</a></li>
                            }
                            else if (User.IsInRole("empresa"))
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="Solicitudes" asp-action="Recibidas">Postulaciones</a></li>
                            }
                            else if (User.IsInRole("admin"))
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Usuarios">Usuarios</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Publicaciones">Publicaciones</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Denuncias">Denuncias</a></li>
                            }
                            @if (!User.IsInRole("admin"))
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="Feed" asp-action="Create">Publicaciones</a></li>
                            }
                        }
                    </ul>
                    </div>
                    <div class="sk-navpill">
                    <ul class="navbar-nav navbar-skilllink-right align-items-xl-center">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item d-flex align-items-center">
                                <a class="nav-link" asp-controller="Notifications" asp-action="Index" title="Notificaciones">
                                    <i class="bi bi-bell"></i>
                                    <span id="notif-badge" class="badge rounded-pill bg-danger d-none">0</span>
                                </a>
                            </li>
                            @if (User.IsInRole("trabajador"))
                            {
                                <li class="nav-item d-flex align-items-center">
                                    <a class="nav-link" asp-controller="Worker" asp-action="Perfil" title="Mi perfil">
                                        <i class="bi bi-person-circle"></i>
                                    </a>
                                </li>
                            }
                            else if (User.IsInRole("empresa"))
                            {
                                <li class="nav-item d-flex align-items-center">
                                    <a class="nav-link" asp-controller="Company" asp-action="Perfil" title="Mi perfil">
                                        <i class="bi bi-person-circle"></i>
                                    </a>
                                </li>
                            }
                            else if (User.IsInRole("admin"))
                            {
                                <li class="nav-item d-flex align-items-center">
                                    <a class="nav-link" asp-controller="Admin" asp-action="Usuarios" title="Mi perfil">
                                        <i class="bi bi-person-circle"></i>
                                    </a>
                                </li>
                            }
                            <li class="nav-item d-flex align-items-center">
                                <a class="nav-link px-2" asp-controller="Dashboard" asp-action="Index">Panel</a>
                            </li>
                            <li class="nav-item d-flex align-items-center">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-link nav-link sk-navpill-link">Cerrar sesión</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item d-flex align-items-center">
                                <a class="btn btn-sm" asp-controller="Account" asp-action="Login">Iniciar sesión</a>
                            </li>
                            <li class="nav-item d-flex align-items-center">
                                <a class="btn btn-sm" asp-controller="Account" asp-action="Register">Registrarse</a>
                            </li>
                        }
                    </ul>
                    </div>
                </div>
            </div>
        </div>
    </nav>

    <main class="container py-4 flex-fill">
        @if (TempData["Success"] is string s) { <div class="alert alert-success alert-dismissible fade show">@s<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }
        @if (TempData["Info"] is string i) { <div class="alert alert-info alert-dismissible fade show">@i<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }
        @if (TempData["Warning"] is string w) { <div class="alert alert-warning alert-dismissible fade show">@w<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }
        @if (TempData["Error"] is string e) { <div class="alert alert-danger alert-dismissible fade show">@e<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }
        @RenderBody()
    </main>

    <footer class="bg-dark text-light py-4 mt-auto w-100">
        <div class="container text-center">
            <p class="mb-0"><strong>SkillLink</strong> — Oportunidades para quienes trabajan con las manos y la experiencia.</p>
            <small class="text-secondary">Sin títulos obligatorios. Con transparencia, DNI y moderación.</small>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/notificaciones.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
