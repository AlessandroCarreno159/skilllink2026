@* Panel principal del usuario *@
@{ ViewData["Title"] = "Panel"; }
<h2 class="sk-section-title">Panel</h2>
<p>Estado de cuenta: <span class="sk-badge-tipo">@ViewBag.Estado</span></p>
<p>Reputación: <strong>@(((double)ViewBag.RepPromedio).ToString("0.0"))/5</strong> (@ViewBag.RepTotal valoraciones)</p>
<h4 class="sk-section-title">Mis publicaciones</h4>
@{
  var publicaciones = (IEnumerable<SkillLink_dotnet.Models.Publicacion>)ViewBag.Pubs;
}
@if (!publicaciones.Any())
{
  <partial name="_EmptyState" model='"No hay publicaciones vigentes."' />
}
else
{
  @foreach (var p in publicaciones)
  {
    <div class="card mb-2 sk-item"><div class="card-body">
      <span class="sk-badge-tipo">@p.Tipo</span> <strong>@(p.Titulo ?? "(sin título)")</strong>
      <a asp-controller="Feed" asp-action="Details" asp-route-id="@p.Id" class="ms-2">Ver</a>
    </div></div>
  }
}
@if (ViewBag.Postulaciones is List<(SkillLink_dotnet.Models.Solicitud S, SkillLink_dotnet.Models.Publicacion P, string? Razon)> postulaciones)
{
  <h4 class="sk-section-title mt-4">Mis postulaciones</h4>
  <partial name="~/Views/Solicitudes/_MisPostulacionesTabla.cshtml" model="postulaciones" />
}
@if (ViewBag.PostulacionesRecibidas is List<SkillLink_dotnet.Models.Solicitud> recibidas)
{
  <h4 class="sk-section-title mt-4">Postulaciones recibidas</h4>
  <partial name="~/Views/Solicitudes/_PostulacionesRecibidasTabla.cshtml" model="recibidas" />
}
