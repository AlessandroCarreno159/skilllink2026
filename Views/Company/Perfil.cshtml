@* Mi empresa: logo, descripción, datos y documentos *@
@{ ViewData["Title"] = "Mi empresa"; }
@inject ImageUploadService Uploads
<h2>Mi empresa</h2>
@if (ViewBag.Empresa is SkillLink_dotnet.Models.Empresa e)
{
  <div class="card"><div class="card-body">
    <div class="row g-3 align-items-center">
      <div class="col-md-3 text-center">
        <img src="@Uploads.Url(e.Logo)" alt="Logo de la empresa" class="img-fluid rounded mb-2" style="width:150px;height:150px;object-fit:cover" />
        <form asp-action="SubirLogo" method="post" enctype="multipart/form-data">
          @Html.AntiForgeryToken()
          <div class="input-group input-group-sm">
            <input name="logo" type="file" class="form-control" accept="image/*" required />
            <button class="btn btn-outline-primary" title="Subir logo"><i class="bi bi-upload"></i></button>
          </div>
          <small class="text-muted">JPG/PNG/WebP hasta 5 MB.</small>
        </form>
      </div>
      <div class="col-md-9">
        <div class="d-flex justify-content-between align-items-center">
          <h4>@e.RazonSocial</h4>
          <a asp-action="EditarDatos" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i> Editar datos</a>
        </div>
        <p class="text-muted">@e.Sector · @e.Ciudad · @e.Telefono · RUC @e.Ruc</p>
        <p>@e.Descripcion</p>
        <form asp-action="GuardarDescripcion" method="post" class="mb-2">
          @Html.AntiForgeryToken()
          <label class="form-label fw-bold" for="descripcion">Editar descripción</label>
          <textarea name="descripcion" id="descripcion" class="form-control" rows="3" maxlength="2000">@e.Descripcion</textarea>
          <button class="btn btn-sm btn-primary mt-2"><i class="bi bi-check-lg"></i> Guardar descripción</button>
        </form>
      </div>
    </div>
  </div></div>
  <h4 class="mt-3">Documentos de acreditación</h4>
  <form asp-action="SubirDocumento" method="post" enctype="multipart/form-data" class="mb-2">
    @Html.AntiForgeryToken()
    <div class="input-group input-group-sm">
      <input name="documento" type="file" class="form-control" accept=".pdf,.jpg,.jpeg,.png,.webp" required />
      <button class="btn btn-outline-primary" title="Subir documento"><i class="bi bi-upload"></i> Subir</button>
    </div>
    <small class="text-muted">PDF o imagen hasta 10 MB.</small>
  </form>
  @foreach (var d in (IEnumerable<SkillLink_dotnet.Models.DocumentoAcreditacion>)ViewBag.Documentos)
  {
    <div class="card mb-2"><div class="card-body py-2">
      <i class="bi bi-file-earmark-check"></i>
      <a href="~/uploads/@d.Archivo" target="_blank">@(d.NombreOriginal ?? d.Archivo)</a>
      <small class="text-muted">· @d.FechaSubida.ToLocalTime()</small>
    </div></div>
  }
}
else { <div class="alert alert-warning">Aún no tiene perfil de empresa.</div> }
