@* Página de inicio *@
@model IEnumerable<SkillLink_dotnet.Models.Publicacion>
@{ ViewData["Title"] = "Inicio"; }
<div class="row align-items-center g-4 mb-4">
  <div class="col-md-6">
    <img src="/img/hero-trabajo.png" alt="Trabajadores" class="sk-hero-img" />
  </div>
  <div class="col-md-6">
    <h1 class="sk-hero-title">Encuentra oportunidades.<br />Conecta con talento.</h1>
    <p class="mt-3">SkillLink es la plataforma peruana que conecta profesionales, técnicos, estudiantes y trabajadores con empresas y clientes.</p>
  </div>
</div>
<div class="sk-cta-banner p-4 p-md-5 mb-5">
  <div class="row align-items-center">
    <div class="col-md-8">
      <h2>Oportunidades para quienes trabajan con las manos y la experiencia.</h2>
    </div>
    <div class="col-md-4 text-md-end mt-3 mt-md-0">
      <a class="btn sk-btn-lila" asp-controller="Feed" asp-action="Index"><i class="bi bi-briefcase-fill"></i> Ver Feed Laboral</a>
    </div>
  </div>
</div>
<h3 class="sk-section-title mb-3"><i class="bi bi-newspaper sk-ic-brand"></i> Publicaciones recientes</h3>
<div class="row">
@foreach (var p in Model)
{
  <div class="col-md-6 mb-3">
    <partial name="_PublicacionCard" model="p" />
  </div>
}
</div>
<div class="text-center mt-2 mb-4">
  <a asp-controller="Feed" asp-action="Index" class="sk-btn-continuar d-inline-block text-decoration-none" style="max-width:280px"><i class="bi bi-plus-circle-fill"></i> Ver Más</a>
</div>
