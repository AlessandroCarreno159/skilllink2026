@* Página de inicio *@
@model IEnumerable<SkillLink_dotnet.Models.Publicacion>
@inject Microsoft.Extensions.Configuration.IConfiguration Cfg
@{
  ViewData["Title"] = "Inicio";
  // Nunca renderizar la clave privilegiada aunque se configure por error en SearchApiKey.
  var algoliaSearchKey = Cfg["Algolia:SearchApiKey"];
  var algoliaIndexingKey = Cfg["Algolia:IndexingApiKey"] ?? Cfg["Algolia:ApiKey"];
  if (!string.IsNullOrWhiteSpace(algoliaSearchKey)
      && string.Equals(algoliaSearchKey, algoliaIndexingKey))
  {
    algoliaSearchKey = null;
  }
}
@if (ViewBag.DbDown == true)
{
  <div class="alert alert-warning" role="alert">
    <i class="bi bi-exclamation-triangle-fill"></i>
    Sin conexión a MySQL: la página carga en modo vista previa sin publicaciones.
    Configure <code>ConnectionStrings:DefaultConnection</code> e instale MySQL para ver datos reales.
  </div>
}
<div class="row align-items-center g-4 mb-4">
  <div class="col-md-6">
    <img src="/img/hero-trabajo.png" alt="Trabajadores" class="sk-hero-img" />
  </div>
  <div class="col-md-6">
    <h1 class="sk-hero-title">Encuentra oportunidades.<br />Conecta con talento.</h1>
    <p class="mt-3">SkillLink es la plataforma peruana que conecta profesionales, técnicos, estudiantes y trabajadores con empresas y clientes.</p>

    <div id="sk-search"
         class="sk-search"
         data-app-id="@Cfg["Algolia:ApplicationId"]"
         data-search-key="@algoliaSearchKey"
         data-index-name="@(Cfg["Algolia:IndexName"] ?? "skilllink_index")"
         data-details-base="@Url.Action("Details", "Feed")"
         data-feed-url="@Url.Action("Index", "Feed")">
      <form class="sk-search-form" role="search" asp-controller="Feed" asp-action="Index" method="get" autocomplete="off">
        <div class="sk-search-box">
          <i class="bi bi-search" aria-hidden="true"></i>
          <input type="search"
                 id="inputBusqueda"
                 name="q"
                 class="sk-search-input"
                 placeholder="Busca oficios, habilidades u oportunidades…"
                 aria-label="Buscar publicaciones"
                 aria-autocomplete="list"
                 aria-controls="search-results-container"
                 aria-expanded="false"
                 autocomplete="off" />
          <button type="button" class="sk-search-clear" data-sk-search-clear hidden aria-label="Limpiar búsqueda">
            <i class="bi bi-x-circle-fill"></i>
          </button>
        </div>
        <div id="search-results-container"
             class="sk-search-results"
             data-sk-search-results
             role="listbox"
             aria-label="Resultados de búsqueda"
             aria-live="polite"
             hidden></div>
      </form>
    </div>
  </div>
</div>
<div class="sk-cta-banner p-4 p-md-5 mb-5">
  <div class="row align-items-center">
    <div class="col-md-8">
      <h2>Oportunidades para quienes trabajan con las manos y la experiencia.</h2>
    </div>
    <div class="col-md-4 text-md-end mt-3 mt-md-0">
      <a class="btn sk-btn-lila" asp-controller="Feed" asp-action="Index"><i class="bi bi-briefcase-fill"></i> Ver Feed Laboral</a>
    </div>
  </div>
</div>
<h3 class="sk-section-title mb-3"><i class="bi bi-newspaper sk-ic-brand"></i> Publicaciones recientes</h3>
<div class="row">
@foreach (var p in Model)
{
  <div class="col-md-6 mb-3">
    <partial name="_PublicacionCard" model="p" />
  </div>
}
</div>
<div class="text-center mt-2 mb-4">
  <a asp-controller="Feed" asp-action="Index" class="sk-btn-continuar d-inline-block text-decoration-none" style="max-width:280px"><i class="bi bi-plus-circle-fill"></i> Ver Más</a>
</div>

@section Scripts {
  <script src="https://cdn.jsdelivr.net/npm/algoliasearch@4.24.0/dist/algoliasearch-lite.umd.js"></script>
  <script src="~/js/busqueda-algolia.js" asp-append-version="true"></script>
}
