@* Detalle de publicación con comentarios *@
@model SkillLink_dotnet.Models.Publicacion
@inject ImageUploadService Uploads
@using SkillLink_dotnet.Services
@{
  ViewData["Title"] = Model.Titulo ?? "Detalle";
  var autorUrl = ImageUploadService.PerfilUrl(Model.Autor);
  var totalComent = (int)(ViewBag.TotalComentarios ?? 0);
  var ratingProm = (double)(ViewBag.RatingPromedio ?? 0);
  var ratingTotal = (int)(ViewBag.RatingTotal ?? 0);
  var miVoto = (int?)(ViewBag.MiCalificacion as int?);
  var email = Model.Autor?.Email ?? "";
  var telefono = Model.Autor?.Perfil?.Telefono ?? Model.Autor?.Empresa?.Telefono ?? Model.Autor?.PhoneNumber ?? "—";
  var tags = (Model.HabilidadesReq ?? "").Split(new[] { ',', ';' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
  var comentarios = (IEnumerable<SkillLink_dotnet.Models.ComentarioPublicacion>)ViewBag.Comentarios;
  var valoraciones = (IEnumerable<SkillLink_dotnet.Models.ComentarioValoracion>)(ViewBag.Valoraciones ?? Enumerable.Empty<SkillLink_dotnet.Models.ComentarioValoracion>());
  var respuestasVal = (IEnumerable<SkillLink_dotnet.Models.ComentarioValoracion>)(ViewBag.RespuestasValoracion ?? Enumerable.Empty<SkillLink_dotnet.Models.ComentarioValoracion>());
}
<div class="row g-4">
  <div class="col-lg-4">
    <h2 class="sk-section-title">@(Model.Titulo ?? "(sin título)")</h2>
    @if (Model.Vacantes.HasValue)
    {
      <p class="sk-serif fs-5">@Model.Vacantes vacante(s) disponible(s)</p>
    }
    <p class="mb-1"><strong>@(Model.Autor?.Perfil?.Especialidad ?? Model.Autor?.Empresa?.Sector ?? Catalogos.Tipo(Model.Tipo))</strong></p>
    <div class="sk-author-card p-3 mb-3 d-flex align-items-center gap-2">
      @if (autorUrl is null)
      {
        <img src="@Uploads.Avatar(Model.Autor)" alt="" class="rounded-circle" style="width:48px;height:48px;object-fit:cover" />
        <strong>@ImageUploadService.NombrePublico(Model.Autor)</strong>
      }
      else
      {
        <a href="@autorUrl"><img src="@Uploads.Avatar(Model.Autor)" alt="" class="rounded-circle" style="width:48px;height:48px;object-fit:cover" /></a>
        <a href="@autorUrl" class="text-decoration-none text-dark"><strong>@ImageUploadService.NombrePublico(Model.Autor)</strong></a>
      }
    </div>
    <div class="mb-2">
      @foreach (var t in tags.Take(6))
      {
        <span class="sk-tag">@t</span>
      }
      @if (!string.IsNullOrWhiteSpace(Model.Categoria))
      {
        <span class="sk-tag">@Catalogos.Categoria(Model.Categoria)</span>
      }
    </div>
    <p class="sk-meta fs-5">
      <i class="bi bi-star-fill sk-ic-star"></i>
      @(ratingTotal > 0 ? ratingProm.ToString("0.0") + $" · {ratingTotal} calificación(es)" : "Sin calificaciones")
      <span class="ms-3"><i class="bi bi-geo-alt-fill sk-ic-pin"></i> @Catalogos.Ciudad(Model)</span>
    </p>
    <p class="fs-5">@Catalogos.Precio(Model)</p>
    <p class="mb-1"><strong>Contacto:</strong></p>
    <p class="sk-meta mb-1"><i class="bi bi-envelope-fill"></i> @email</p>
    <p class="sk-meta mb-3"><i class="bi bi-telephone-fill"></i> @telefono</p>
    <div class="card p-3 mb-3">
      <h6 class="sk-serif mb-2"><i class="bi bi-star-fill sk-ic-star"></i> Dejar calificación</h6>
      @if (miVoto.HasValue)
      {
        <p class="sk-meta mb-2">Tu voto: <strong>@miVoto / 5</strong> (puedes actualizarlo)</p>
      }
      @if (User.Identity?.IsAuthenticated == true)
      {
        <form asp-controller="Feed" asp-action="Calificar" asp-route-id="@Model.Id" method="post" class="d-flex align-items-center gap-2 flex-wrap">
          @Html.AntiForgeryToken()
          <div class="btn-group" role="group" aria-label="Estrellas">
            @for (var s = 1; s <= 5; s++)
            {
              <input type="radio" class="btn-check" name="calificacion" id="star-@s" value="@s" @(miVoto == s ? "checked" : "") required />
              <label class="btn btn-sm sk-star-btn" for="star-@s">@s ★</label>
            }
          </div>
          <input name="comentario" class="form-control form-control-sm" placeholder="Comentario (opcional)" />
          <button class="btn btn-sm btn-primary" type="submit"><i class="bi bi-check-circle-fill"></i> @(miVoto.HasValue ? "Actualizar" : "Calificar")</button>
        </form>
      }
      else
      {
        <p class="sk-meta mb-0"><a asp-controller="Account" asp-action="Login">Iniciar sesión</a> para calificar esta publicación.</p>
      }
    </div>
    @if (User.IsInRole("admin"))
    {
      <form asp-controller="Admin" asp-action="EliminarPublicacion" asp-route-id="@Model.Id" method="post" class="mb-3" onsubmit="return confirm('Eliminar DEFINITIVAMENTE esta publicación?');">
        @Html.AntiForgeryToken()
        <input type="hidden" name="returnUrl" value="/Feed" />
        <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash-fill"></i> Eliminar publicación</button>
      </form>
    }
    @if (User.IsInRole("trabajador") && Model.Tipo == "oferta")
    {
      <form asp-controller="Solicitudes" asp-action="Postular" method="post" class="mb-3">
        @Html.AntiForgeryToken()
        <input type="hidden" name="publicacionId" value="@Model.Id" />
        <div class="input-group">
          <input name="mensaje" class="form-control" placeholder="Mensaje de postulación (opcional)" />
          <button class="btn btn-success"><i class="bi bi-check-circle-fill"></i> Postular</button>
        </div>
      </form>
    }
    @if (User.Identity?.IsAuthenticated == true)
    {
      <button class="btn btn-sm btn-outline-secondary mb-2" type="button" data-bs-toggle="collapse" data-bs-target="#denunciarPublicacion" aria-expanded="false" aria-controls="denunciarPublicacion">
        <i class="bi bi-flag"></i> Denunciar publicación
      </button>
      <div class="collapse mb-3" id="denunciarPublicacion">
        <form asp-controller="Feed" asp-action="Denunciar" method="post" class="card p-3">
          @Html.AntiForgeryToken()
          <input type="hidden" name="publicacionId" value="@Model.Id" />
          <label class="form-label small mb-1" for="motivo-pub">Motivo</label>
          <select id="motivo-pub" name="motivo" class="form-select form-select-sm mb-2" required>
            <option value="spam">Spam</option>
            <option value="estafa">Estafa o fraude</option>
            <option value="ofensivo">Contenido ofensivo</option>
            <option value="peligroso">Amenaza o contenido peligroso</option>
            <option value="falso">Información falsa</option>
            <option value="basura">Contenido basura o sin sentido</option>
            <option value="otro">Otro</option>
          </select>
          <textarea name="descripcion" class="form-control form-control-sm mb-2" rows="2" maxlength="500" placeholder="Detalle (opcional)"></textarea>
          <button class="btn btn-sm btn-outline-danger" type="submit">Enviar denuncia</button>
        </form>
      </div>
    }
  </div>
  <div class="col-lg-8">
    <div class="sk-detail-panel p-4">
      <div class="row g-4">
        <div class="col-md-7">
          <img src="@Uploads.Url(Model.Imagen)" alt="Imagen de la publicación" class="img-fluid rounded" style="width:100%;max-height:320px;object-fit:cover" />
        </div>
        <div class="col-md-5">
          <h5 class="sk-serif"><i class="bi bi-patch-check-fill sk-ic-brand"></i> Experiencia y verificación</h5>
          <ul class="small">
            <li>Identidad verificada</li>
            <li>Perfil verificado</li>
            <li>@(Model.Autor?.Perfil?.Especialidad ?? Model.Autor?.Empresa?.Sector ?? Catalogos.Tipo(Model.Tipo))</li>
          </ul>
        </div>
      </div>
      <h5 class="sk-serif mt-4">Descripción:</h5>
      <p>@Model.Contenido</p>
      <div class="row small mt-3">
        <div class="col-md-6"><i class="bi bi-clock-fill sk-ic-brand"></i> <strong>Modalidad:</strong> @Catalogos.Modalidad(Model.Modalidad)</div>
        <div class="col-md-6"><i class="bi bi-grid-fill sk-ic-brand"></i> <strong>Categoría:</strong> @Catalogos.Categoria(Model.Categoria)</div>
        <div class="col-md-6"><i class="bi bi-cash-coin sk-ic-cash"></i> <strong>Precio:</strong> @Catalogos.Precio(Model)</div>
        <div class="col-md-6"><i class="bi bi-calendar3"></i> <strong>Publicado:</strong> @Model.FechaCreacion.ToLocalTime().ToString("dd/MM/yyyy")</div>
      </div>
    </div>
  </div>
</div>
<button class="sk-btn-comments mt-4" type="button" data-bs-toggle="collapse" data-bs-target="#comentarios" aria-expanded="false" aria-controls="comentarios">
  <i class="bi bi-chat-dots-fill"></i> Ver comentarios (@totalComent)
</button>
<div class="collapse mt-3" id="comentarios">
  <form asp-action="Comment" asp-route-id="@Model.Id" method="post" class="mb-3">
    @Html.AntiForgeryToken()
    <div class="input-group"><input name="comentario" class="form-control" placeholder="Escribe un comentario…" /><button class="btn btn-secondary"><i class="bi bi-send-fill"></i> Comentar</button></div>
  </form>
  @foreach (var c in comentarios)
  {
    var perfilUrl = ImageUploadService.PerfilUrl(c.Autor);
    <div class="card mb-2 sk-item"><div class="card-body d-flex gap-2 align-items-start">
      @if (perfilUrl is null)
      {
        <img src="@Uploads.Avatar(c.Autor)" alt="Foto de perfil" class="rounded-circle flex-shrink-0" style="width:40px;height:40px;object-fit:cover" loading="lazy" />
      }
      else
      {
        <a href="@perfilUrl"><img src="@Uploads.Avatar(c.Autor)" alt="Foto de perfil" class="rounded-circle flex-shrink-0" style="width:40px;height:40px;object-fit:cover" loading="lazy" /></a>
      }
      <div>
        @if (perfilUrl is null)
        {
          <strong>@ImageUploadService.NombrePublico(c.Autor)</strong>
        }
        else
        {
          <a href="@perfilUrl" class="text-decoration-none"><strong>@ImageUploadService.NombrePublico(c.Autor)</strong></a>
        }
        <br />
        @c.Comentario<br />
        <small class="text-muted">@c.Fecha.ToLocalTime()</small>
        @if (User.Identity?.IsAuthenticated == true)
        {
          <details class="mt-1">
            <summary class="small text-muted">Denunciar comentario</summary>
            <form asp-controller="Feed" asp-action="DenunciarComentario" method="post" class="mt-2">
              @Html.AntiForgeryToken()
              <input type="hidden" name="comentarioId" value="@c.Id" />
              <input type="hidden" name="publicacionId" value="@Model.Id" />
              <div class="d-flex gap-2 flex-wrap">
                <select name="motivo" class="form-select form-select-sm" style="max-width:200px" required>
                  <option value="spam">Spam</option>
                  <option value="estafa">Estafa o fraude</option>
                  <option value="ofensivo">Contenido ofensivo</option>
                  <option value="peligroso">Amenaza o contenido peligroso</option>
                  <option value="falso">Información falsa</option>
                  <option value="basura">Contenido basura o sin sentido</option>
                  <option value="otro">Otro</option>
                </select>
                <button class="btn btn-sm btn-outline-danger" type="submit">Enviar</button>
              </div>
            </form>
          </details>
        }
      </div>
    </div></div>
  }
</div>
<h4 class="sk-section-title mt-4"><i class="bi bi-star-fill sk-ic-star"></i> Calificaciones (@ratingTotal)</h4>
@foreach (var v in valoraciones)
{
  var vUrl = ImageUploadService.PerfilUrl(v.Autor);
  <div class="card mb-2 sk-item"><div class="card-body">
    <div class="d-flex gap-2 align-items-start">
      @if (vUrl is null)
      {
        <img src="@Uploads.Avatar(v.Autor)" alt="" class="rounded-circle flex-shrink-0" style="width:40px;height:40px;object-fit:cover" loading="lazy" />
        <div><strong>@ImageUploadService.NombrePublico(v.Autor)</strong></div>
      }
      else
      {
        <a href="@vUrl"><img src="@Uploads.Avatar(v.Autor)" alt="" class="rounded-circle flex-shrink-0" style="width:40px;height:40px;object-fit:cover" loading="lazy" /></a>
        <div><a href="@vUrl" class="text-decoration-none"><strong>@ImageUploadService.NombrePublico(v.Autor)</strong></a></div>
      }
      <span class="ms-auto text-warning">@for (var i = 0; i < (v.Calificacion ?? 0); i++) {<i class="bi bi-star-fill"></i>}</span>
    </div>
    @if (!string.IsNullOrWhiteSpace(v.Comentario))
    {
      <p class="mb-1 mt-2">@v.Comentario</p>
    }
    <small class="text-muted">@v.Fecha.ToLocalTime()</small>
    @foreach (var r in respuestasVal.Where(x => x.ParentId == v.Id))
    {
      var rUrl = ImageUploadService.PerfilUrl(r.Autor);
      <div class="ms-4 mt-2 p-2 border-start border-3">
        <strong>@ImageUploadService.NombrePublico(r.Autor)</strong>
        <span class="text-muted">→ @(r.RespuestaAUsuarioId == v.AutorId ? ImageUploadService.NombrePublico(v.Autor) : "")</span><br />
        @r.Comentario<br />
        <small class="text-muted">@r.Fecha.ToLocalTime()</small>
      </div>
    }
    @if (User.Identity?.IsAuthenticated == true)
    {
      <form asp-controller="Feed" asp-action="ResponderValoracion" asp-route-valoracionId="@v.Id" method="post" class="mt-2">
        @Html.AntiForgeryToken()
        <div class="input-group input-group-sm"><input name="comentario" class="form-control" placeholder="Responder…" /><button class="btn btn-outline-secondary">Responder</button></div>
      </form>
    }
  </div></div>
}
