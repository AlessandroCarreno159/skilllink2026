@* Feed laboral: lista de publicaciones con filtros *@
@model IEnumerable<SkillLink_dotnet.Models.Publicacion>
@inject ImageUploadService Uploads
@using SkillLink_dotnet.Services
@{ ViewData["Title"] = "Feed laboral"; }
<div class="row">
  <div class="col-lg-3">
    <partial name="_FiltrosSidebar" />
  </div>
  <div class="col-lg-9">
    <h2 class="sk-section-title mb-3"><i class="bi bi-briefcase-fill sk-ic-brand"></i> Feed laboral</h2>
    <div class="mb-4">
      <partial name="_BuscadorAlgolia" />
    </div>
    <div class="feed-list">
    @if (ViewBag.SearchError is string searchError)
    {
      <div class="alert alert-warning sk-toast sk-toast-warn" role="alert"><i class="bi bi-exclamation-triangle-fill"></i> @searchError</div>
    }
    else if (!Model.Any())
    {
      if (!string.IsNullOrWhiteSpace(ViewBag.Q as string))
      {
        <div class="alert alert-info sk-toast sk-toast-info" role="status"><i class="bi bi-search"></i> No se encontraron publicaciones para “@ViewBag.Q”.</div>
      }
      else
      {
        <div class="alert alert-info sk-toast sk-toast-info" role="status"><i class="bi bi-info-circle-fill"></i> No hay publicaciones con esos filtros.</div>
      }
    }
    @foreach (var p in Model)
    {
      <partial name="_PublicacionCard" model="p" />
    }
    </div>
    @{
      int pagina = ViewBag.Pagina ?? 1;
      int totalPaginas = ViewBag.TotalPaginas ?? 1;
    }
    @if (totalPaginas > 1)
    {
      <nav aria-label="Paginación del feed" class="my-4 pb-2">
        <ul class="pagination justify-content-center">
          <li class="page-item @(pagina <= 1 ? "disabled" : "")">
            <a class="page-link" asp-action="Index" asp-route-pagina="@(pagina - 1)" asp-route-q="@ViewBag.Q" asp-route-ciudad="@ViewBag.Ciudad" asp-route-tipo="@ViewBag.Tipo" asp-route-modalidad="@ViewBag.Modalidad" asp-route-categoria="@ViewBag.Categoria" asp-route-estrellas="@ViewBag.Estrellas" asp-route-opCalif="@ViewBag.OpCalif" aria-label="Anterior"><span aria-hidden="true">&laquo;</span></a>
          </li>
          @for (var i = 1; i <= totalPaginas; i++)
          {
            <li class="page-item @(i == pagina ? "active" : "")">
              <a class="page-link" asp-action="Index" asp-route-pagina="@i" asp-route-q="@ViewBag.Q" asp-route-ciudad="@ViewBag.Ciudad" asp-route-tipo="@ViewBag.Tipo" asp-route-modalidad="@ViewBag.Modalidad" asp-route-categoria="@ViewBag.Categoria" asp-route-estrellas="@ViewBag.Estrellas" asp-route-opCalif="@ViewBag.OpCalif">@i</a>
            </li>
          }
          <li class="page-item @(pagina >= totalPaginas ? "disabled" : "")">
            <a class="page-link" asp-action="Index" asp-route-pagina="@(pagina + 1)" asp-route-q="@ViewBag.Q" asp-route-ciudad="@ViewBag.Ciudad" asp-route-tipo="@ViewBag.Tipo" asp-route-modalidad="@ViewBag.Modalidad" asp-route-categoria="@ViewBag.Categoria" asp-route-estrellas="@ViewBag.Estrellas" asp-route-opCalif="@ViewBag.OpCalif" aria-label="Siguiente"><span aria-hidden="true">&raquo;</span></a>
          </li>
        </ul>
      </nav>
    }
  </div>
</div>

@section Scripts {
  <script src="https://cdn.jsdelivr.net/npm/algoliasearch@4.24.0/dist/algoliasearch-lite.umd.js"></script>
  <script src="~/js/busqueda-algolia.js" asp-append-version="true"></script>
}
