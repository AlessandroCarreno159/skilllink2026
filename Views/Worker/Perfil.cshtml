@* Mi perfil de trabajador: foto, descripción, datos y documentos *@
@{ ViewData["Title"] = "Mi perfil"; }
@inject ImageUploadService Uploads
<h2>Mi perfil de trabajador</h2>
@if (ViewBag.Perfil is SkillLink_dotnet.Models.Perfil p)
{
  <div class="card mb-3"><div class="card-body">
    <div class="row g-3 align-items-center">
      <div class="col-md-3 text-center">
        <img src="@Uploads.Url(p.Foto)" alt="Foto de perfil" class="img-fluid rounded-circle mb-2" style="width:150px;height:150px;object-fit:cover" />
        <form asp-action="SubirFoto" method="post" enctype="multipart/form-data">
          @Html.AntiForgeryToken()
          <div class="input-group input-group-sm">
            <input name="foto" type="file" class="form-control" accept="image/*" required />
            <button class="btn btn-outline-primary" title="Subir foto"><i class="bi bi-upload"></i></button>
          </div>
          <small class="text-muted">JPG/PNG/WebP hasta 5 MB.</small>
        </form>
      </div>
      <div class="col-md-9">
        <div class="d-flex justify-content-between align-items-center">
          <h4>@p.NombreCompleto</h4>
          <a asp-action="EditarDatos" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i> Editar datos</a>
        </div>
        <p class="text-muted">@p.Especialidad · @p.Ciudad · @p.Telefono</p>
        <p>@p.Descripcion</p>
        <form asp-action="GuardarDescripcion" method="post" class="mb-2">
          @Html.AntiForgeryToken()
          <label class="form-label fw-bold" for="descripcion">Editar descripción</label>
          <textarea name="descripcion" id="descripcion" class="form-control" rows="3" maxlength="2000">@p.Descripcion</textarea>
          <button class="btn btn-sm btn-primary mt-2"><i class="bi bi-check-lg"></i> Guardar descripción</button>
        </form>
        <p><strong>Habilidades:</strong> @p.Habilidades</p>
      </div>
    </div>
  </div></div>
}
else { <div class="alert alert-warning">Aún no tiene perfil.</div> }
<h4 class="mt-3">Experiencia laboral</h4>
@foreach (var e in (IEnumerable<SkillLink_dotnet.Models.ExperienciaLaboral>)ViewBag.Experiencias)
{
  <div class="card mb-2"><div class="card-body"><strong>@e.CargoOficio</strong> en @e.LugarTrabajo (@e.TiempoTrabajado)<br />@e.DescripcionActividades</div></div>
}
<h4 class="mt-3">Documentos de acreditación</h4>
<form asp-action="SubirDocumento" method="post" enctype="multipart/form-data" class="mb-2">
  @Html.AntiForgeryToken()
  <div class="input-group input-group-sm">
    <input name="documento" type="file" class="form-control" accept=".pdf,.jpg,.jpeg,.png,.webp" required />
    <button class="btn btn-outline-primary" title="Subir documento"><i class="bi bi-upload"></i> Subir</button>
  </div>
  <small class="text-muted">PDF o imagen hasta 10 MB.</small>
</form>
@foreach (var d in (IEnumerable<SkillLink_dotnet.Models.DocumentoAcreditacion>)ViewBag.Documentos)
{
  <div class="card mb-2"><div class="card-body py-2">
    <i class="bi bi-file-earmark-check"></i>
    <a href="~/uploads/@d.Archivo" target="_blank">@(d.NombreOriginal ?? d.Archivo)</a>
    <small class="text-muted">· @d.FechaSubida.ToLocalTime()</small>
  </div></div>
}
