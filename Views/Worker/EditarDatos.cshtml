@* Editar datos de trabajador (sin nombre) *@
@model SkillLink_dotnet.ViewModels.TrabajadorDatosVm
@{ ViewData["Title"] = "Editar mis datos"; }
<h2>Editar mis datos</h2>
<p class="text-muted">El nombre completo solo puede modificarlo un administrador.</p>
<form method="post">
  @Html.AntiForgeryToken()
  <div asp-validation-summary="ModelOnly" class="text-danger"></div>
  <div class="row">
    <div class="col-md-6 mb-3"><label asp-for="Ciudad" class="form-label">Departamento</label><input asp-for="Ciudad" class="form-control" /></div>
    <div class="col-md-6 mb-3"><label asp-for="Telefono" class="form-label">Teléfono</label><input asp-for="Telefono" class="form-control" /></div>
  </div>
  <div class="mb-3"><label asp-for="Especialidad" class="form-label">Especialidad</label><input asp-for="Especialidad" class="form-control" /></div>
  <div class="mb-3"><label asp-for="Habilidades" class="form-label">Habilidades</label><input asp-for="Habilidades" class="form-control" /></div>
  <div class="mb-3"><label asp-for="Disponibilidad" class="form-label">Disponibilidad</label>
    <select asp-for="Disponibilidad" class="form-select"><option value="disponible">Disponible</option><option value="ocupado">Ocupado</option></select>
  </div>
  <div class="mb-3"><label asp-for="Descripcion" class="form-label">Descripción</label><textarea asp-for="Descripcion" class="form-control" rows="3"></textarea></div>
  <button class="btn btn-primary"><i class="bi bi-check-lg"></i> Guardar</button>
  <a asp-action="Perfil" class="btn btn-secondary">Volver</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
