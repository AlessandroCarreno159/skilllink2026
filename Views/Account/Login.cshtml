@* Iniciar sesión *@
@model SkillLink_dotnet.ViewModels.LoginVm
@{ ViewData["Title"] = "Iniciar sesión"; }
<div class="row justify-content-center">
  <div class="col-md-5">
    <div class="card shadow">
      <div class="card-body">
        <h2><i class="bi bi-box-arrow-in-right"></i> Iniciar sesión</h2>
        <p class="text-muted">Use su DNI y contraseña para ingresar</p>
        <form asp-action="Login" method="post" novalidate>
          @Html.AntiForgeryToken()
          <div asp-validation-summary="ModelOnly" class="text-danger"></div>
          <div class="mb-3">
            <label asp-for="Dni" class="form-label">DNI (8 dígitos)</label>
            <input asp-for="Dni" class="form-control" maxlength="8" placeholder="12345678" />
            <span asp-validation-for="Dni" class="text-danger"></span>
          </div>
          <div class="mb-3">
            <label asp-for="Password" class="form-label">Contraseña</label>
            <input asp-for="Password" class="form-control" />
            <span asp-validation-for="Password" class="text-danger"></span>
          </div>
          <div class="form-check mb-3">
            <input asp-for="RememberMe" class="form-check-input" />
            <label asp-for="RememberMe" class="form-check-label">Recordarme</label>
          </div>
          <button type="submit" class="btn btn-primary w-100">Ingresar</button>
        </form>
        <div class="mt-3 text-center">¿No tiene cuenta? <a asp-action="Register">Registrarse</a></div>
      </div>
    </div>
  </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
