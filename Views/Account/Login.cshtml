@* Iniciar sesión *@
@model SkillLink_dotnet.ViewModels.LoginVm
@{ ViewData["Title"] = "Iniciar sesión"; }
<div class="row justify-content-center">
  <div class="col-md-6 col-lg-5">
    <div class="sk-auth-card">
      <div class="sk-auth-head"><i class="bi bi-box-arrow-in-right"></i> Iniciar sesión</div>
      <div class="sk-auth-body">
        <p class="text-center text-muted small">Use su DNI y contraseña para ingresar</p>
        <form asp-action="Login" method="post" novalidate>
          @Html.AntiForgeryToken()
          <div asp-validation-summary="ModelOnly" class="text-danger"></div>
          <div class="mb-3">
            <label asp-for="Dni" class="form-label">DNI (8 dígitos)</label>
            <input asp-for="Dni" class="form-control sk-auth-input" maxlength="8" placeholder="12345678" />
            <span asp-validation-for="Dni" class="text-danger"></span>
          </div>
          <div class="mb-3">
            <label asp-for="Password" class="form-label">Contraseña</label>
            <input asp-for="Password" class="form-control sk-auth-input" />
            <span asp-validation-for="Password" class="text-danger"></span>
          </div>
          <div class="form-check mb-4">
            <input asp-for="RememberMe" class="form-check-input" />
            <label asp-for="RememberMe" class="form-check-label">Recordarme</label>
          </div>
          <button type="submit" class="sk-btn-continuar">INGRESAR</button>
        </form>
        <div class="mt-3 text-center">¿No tiene cuenta? <a asp-action="Register" class="sk-auth-link">Registrarse</a></div>
      </div>
    </div>
  </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
