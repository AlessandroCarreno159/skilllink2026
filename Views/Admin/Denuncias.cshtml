@* Admin: ver denuncias *@
@model IEnumerable<SkillLink_dotnet.ViewModels.DenunciaRiesgoVm>
@{
  ViewData["Title"] = "Denuncias";
  var soloRiesgo = (bool)(ViewBag.SoloRiesgo ?? false);
  var modo = ViewBag.Modo as string ?? "Heurístico";
  var vacio = soloRiesgo
    ? "No hay denuncias con riesgo por ahora."
    : "No hay denuncias vigentes por ahora.";
}
<div class="sk-admin-page">
  <h2 class="sk-section-title mb-1">Denuncias</h2>
  <p class="text-muted mb-3">Revisa y resuelve los reportes de la comunidad.</p>
  <div class="sk-admin-toolbar mb-3">
    <a asp-action="Denuncias" class="btn btn-sm @(soloRiesgo ? "sk-btn-lila" : "sk-btn-purple")">Todas</a>
    <a asp-action="Denuncias" asp-route-soloRiesgo="true" class="btn btn-sm @(soloRiesgo ? "sk-btn-purple" : "sk-btn-lila")">Solo con riesgo</a>
    <span class="badge bg-info text-dark">Clasificador: @modo</span>
  </div>

  @if (Model.Any())
  {
    <div class="sk-admin-table">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead><tr><th>Riesgo</th><th>Clase</th><th>Tipo</th><th>Objeto</th><th>Motivo</th><th>Texto</th><th>Estado</th><th>Fecha</th><th>Acciones</th></tr></thead>
          <tbody>
          @foreach (var v in Model)
          {
            var d = v.Denuncia;
            <tr>
              <td><span class="badge bg-@v.Badge" title="Spam @v.ProbabilidadSpam.ToString("P0") · Peligroso @v.ProbabilidadPeligroso.ToString("P0") · Basura @v.ProbabilidadBasura.ToString("P0")">@v.Nivel (@v.Probabilidad.ToString("P0"))</span></td>
              <td><span class="badge bg-@v.BadgeClase">@v.Clase</span></td>
              <td>@d.ObjetoTipo</td><td>@d.ObjetoId</td><td>@d.Motivo</td>
              <td class="small">@v.Extracto</td>
              <td><span class="badge bg-secondary">@d.Estado</span></td>
              <td>@d.Fecha.ToLocalTime()</td>
              <td>
                @if (d.Estado == "pendiente")
                {
                  <form asp-action="ResolverDenuncia" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@d.Id" />
                    <button name="accion" value="resolver" class="btn btn-sm btn-success" title="Confirmar spam">Spam</button>
                    <button name="accion" value="peligroso" class="btn btn-sm btn-danger" title="Contenido peligroso">Peligroso</button>
                    <button name="accion" value="basura" class="btn btn-sm btn-warning">Basura</button>
                    <button name="accion" value="desestimar" class="btn btn-sm btn-outline-secondary">Desestimar</button>
                  </form>
                }
              </td>
            </tr>
          }
          </tbody>
        </table>
      </div>
    </div>
  }
  else
  {
    <partial name="_EmptyState" model="vacio" />
  }
</div>
