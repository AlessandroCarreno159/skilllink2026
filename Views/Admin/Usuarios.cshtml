@* Admin: moderar usuarios (aprobar, rechazar, suspender, banear, editar nombre) *@
@model IEnumerable<SkillLink_dotnet.Models.ApplicationUser>
@{
  var estado = ViewBag.Estado as string ?? "pendiente";
  var esPendiente = estado == "pendiente";
  var titulo = estado switch
  {
    "pendiente" => "Usuarios Pendientes",
    "aprobado" => "Usuarios Aprobados",
    "todos" => "Usuarios",
    _ => $"Usuarios {estado}"
  };
  var vacio = estado switch
  {
    "pendiente" => "No hay usuarios pendientes por ahora",
    "aprobado" => "No hay usuarios aprobados por ahora.",
    "todos" => "No hay usuarios registrados por ahora.",
    _ => "No hay usuarios para mostrar."
  };
  ViewData["Title"] = titulo;
}
<div class="sk-admin-page">
  <h2 class="sk-section-title mb-1">@titulo</h2>
  <p class="text-muted mb-3">
    @(esPendiente
      ? "Aceptar o rechazar usuarios pendientes de aprobación."
      : "Gestiona las cuentas registradas en SkillLink.")
  </p>
  <div class="sk-admin-toolbar mb-3">
    <a asp-action="Usuarios" asp-route-estado="pendiente" class="btn btn-sm @(esPendiente ? "sk-btn-purple" : "sk-btn-lila")">Pendientes</a>
    <a asp-action="Usuarios" asp-route-estado="aprobado" class="btn btn-sm @(estado == "aprobado" ? "sk-btn-purple" : "sk-btn-lila")">Aprobados</a>
    <a asp-action="Usuarios" asp-route-estado="todos" class="btn btn-sm @(estado == "todos" ? "sk-btn-purple" : "sk-btn-lila")">Todos</a>
  </div>

  @if (Model.Any())
  {
    <div class="sk-admin-table">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead><tr><th>DNI</th><th>Nombre</th><th>Email</th><th>Rol</th><th>Estado</th><th>Acciones</th></tr></thead>
          <tbody>
          @foreach (var u in Model)
          {
            <tr>
              <td>@u.Dni</td>
              <td>@SkillLink_dotnet.Services.ImageUploadService.NombrePublico(u)</td>
              <td>@u.Email</td><td>@u.Rol</td>
              <td>
                <span class="badge bg-secondary">@u.EstadoCuenta</span>
                @if (u.Sospechoso)
                {
                  <span class="badge bg-danger" title="Faltas de moderación: @u.FaltasModeracion">Sospechoso</span>
                }
              </td>
              <td>
                <a asp-action="EditarNombre" asp-route-id="@u.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i> Nombre</a>
                <form asp-action="Gestionar" method="post" class="d-inline">
                  @Html.AntiForgeryToken()
                  <input type="hidden" name="id" value="@u.Id" />
                  <button name="accion" value="aprobar" class="btn btn-sm btn-success">Aprobar</button>
                  <button name="accion" value="rechazar" class="btn btn-sm btn-warning">Rechazar</button>
                  <button name="accion" value="suspender" class="btn btn-sm btn-secondary">Suspender</button>
                  <button name="accion" value="banear" class="btn btn-sm btn-danger">Banear</button>
                </form>
              </td>
            </tr>
          }
          </tbody>
        </table>
      </div>
    </div>
  }
  else
  {
    <partial name="_EmptyState" model="vacio" />
  }
</div>
