# --- Gateway Socket.io / Redis ---
PORT=3001
# Cadena de Upstash (rediss://). Configúrala en tu .env local o en el panel
# del hosting; nunca la commitees con credenciales reales.
REDIS_URL=rediss://default:TU_PASSWORD@TU_HOST.upstash.io:6379
# Debe coincidir con Realtime:Secret de appsettings.Development.json
REALTIME_SECRET=dev-skilllink-realtime-secret
REALTIME_CHANNEL=skilllink:events
CORS_ORIGIN=http://localhost:5276,https://localhost:7189,http://localhost:5000,https://localhost:5001,http://localhost:8080,https://localhost:8080
PRESENCE_TTL=120
CHAT_HISTORY_LIMIT=200

# --- ASP.NET Core (referencia; normalmente se configuran en appsettings o variables de entorno) ---
# REDIS_URL=rediss://default:TU_PASSWORD@TU_HOST.upstash.io:6379
# Realtime__Url=http://localhost:3001
# Realtime__Secret=dev-skilllink-realtime-secret
# ConnectionStrings__DefaultConnection=server=localhost;port=3306;database=skilllink_db;user=root;password=TU_PASSWORD

# --- Asistente virtual (Gemini) ---
# En desarrollo usa user-secrets: dotnet user-secrets set "Chatbot:ApiKey" "..."
# Chatbot__Enabled=true
# Chatbot__Model=gemini-flash-lite-latest
# Chatbot__FallbackModel=gemini-3.1-flash-lite
# Chatbot__ApiKey=TU_API_KEY
# Chatbot__SupportUrl=https://wa.me/+51936211313

# --- Tipo de cambio PEN/USD (ExchangeRate-API) ---
# En desarrollo usa user-secrets: dotnet user-secrets set "Currency:ApiKey" "TU_API_KEY"
# Sin key, el precio dual se omite y solo se muestra la moneda base.
# Currency__Enabled=true
# Currency__ApiKey=TU_API_KEY
# Currency__BaseUrl=https://v6.exchangerate-api.com/v6
# Currency__CacheHours=12
# Currency__FallbackPenToUsd=0.29
